# The onramp kit ships from Circle's private Cloudsmith registry, not npmjs.
# Only the @crcl-main scope is redirected; everything else still resolves from
# the default registry.
#
# CLOUDSMITH_TOKEN must be exported in the shell running `npm install` — npm
# expands ${...} from the environment when it reads this file. Keep the token
# out of the repo.
@crcl-main:registry=https://npm.cloudsmith.io/circle/common-private/
//npm.cloudsmith.io/circle/common-private/:_authToken=${CLOUDSMITH_TOKEN}
