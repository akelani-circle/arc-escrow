# Deployment URL (e.g., https://your-app.vercel.app)
VERCEL_URL=
NEXT_PUBLIC_VERCEL_URL=

# Supabase configuration (https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# USDC Smart Contract configuration
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=

# Agent Wallet configuration
NEXT_PUBLIC_AGENT_WALLET_ID=
NEXT_PUBLIC_AGENT_WALLET_ADDRESS=

# Circle API configuration (https://console.circle.com/apikeys)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_BLOCKCHAIN=

# OpenAI API configuration (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Circle Onramp Kit configuration (https://console.circle.com/api-keys)
#
# Kit key, in the form KIT_KEY:<keyId>:<keySecret>. A key is bound to one
# environment: a sandbox key is rejected by production and vice-versa, so it has
# to match the base URLs below.
ONRAMP_KIT_KEY=

# Sandbox endpoints. Keep these set. This app runs on Arc Testnet, and removing
# either line targets Circle's production API and widget on mainnet, where every
# purchase charges a real payment method and delivers to a chain the escrow
# wallet does not exist on. Set both together — the app refuses to start if they
# disagree.
ONRAMP_API_BASE_URL=https://api-test.circle.com
NEXT_PUBLIC_ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io

# Google sign-in configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
